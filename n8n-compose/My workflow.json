      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst matches = [...body.matchAll(\n  /<td.*?>(.*?)<\\/td>\\s*<td.*?>(.*?)<\\/td>/gs\n)];\n\nconst result = {};\n\nfor (const match of matches) {\n\n  const key = match[1]\n    .replace(/<[^>]*>/g, '')\n    .trim();\n\n  const value = match[2]\n    .replace(/<[^>]*>/g, '')\n    .trim();\n\n  result[key] = value;\n}\n\nreturn [\n  {\n    json: result\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "fe524ef4-83f7-4467-ada9-1f13d749201f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nreturn [\n  {\n    json: {\n      transacttime: data[\"Trade Date and Time\"],\n\n      orderid: data[\"Trade ID/Reference\"],\n\n      side: data[\"Trade Direction (Client Buy/ Client sell)\"],\n\n      symbol: \"BTCHKD\",\n\n      orderqty: parseFloat(\n        data[\"Quantity (unit)\"]\n          .replace(\"BTC\", \"\")\n          .trim()\n      ),\n\n      bitprice: parseFloat(\n        data[\"Price per unit\"]\n          .replace(/,/g, \"\")\n      ),\n\n      turnover: parseFloat(\n        data[\"Consideration amount (value/quantity)\"]\n          .replace(/,/g, \"\")\n      ),\n\n      handling_fee: parseFloat(\n        data[\"Fees/Commissions:\"]\n          .replace(\"HKD\", \"\")\n          .trim()\n      ),\n\n      settlement_amount: parseFloat(\n        data[\"Settlement amount (value/quantity)\"]\n          .replace(\"HKD\", \"\")\n          .replace(/,/g, \"\")\n          .trim()\n      )\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
